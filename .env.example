# ---- 텔레그램 ----
# BotFather에서 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 메시지를 받을 채팅 ID (숫자 또는 @username)
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- FRED (미국 국채 등 시계열, 키 없으면 해당 항목 스킵) ----
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- 브리핑 항목별 설정 ----
# 상품: Stooq 심볼 쉼표 구분 (예: CL.F, WTI, BZ.F)
BRIEF_COMMODITIES_SYMBOLS=CL.F,WTI.F,BZ.F

# 비상장/프라이빗 회사: 수동 입력값 (없으면 N/A)
BRIEF_PRIVATE_COMPANY=
# 위 항목 링크 (선택)
BRIEF_PRIVATE_COMPANY_LINK=

# VIX: Stooq 실패 시 수동값
VIX_MANUAL=

# ADR Index: 수동값 우선, 없으면 Stooq 심볼로 조회
BRIEF_ADR_INDEX=
BRIEF_ADR_INDEX_SYMBOL=^BKX

# 환율: Stooq 심볼 쉼표 구분 (예: USDKRW=X, JPYKRW=X)
BRIEF_FX_PAIRS=USDKRW=X,JPYKRW=X

# BDI (발틱운임지수): Stooq 실패 시 수동값
BDI_MANUAL=

# 블로그/뉴스: RSS URL (쉼표로 여러 개 입력 가능, 각 블로그당 최대 2개)
#   - 형식 예시: 메르의 블로그|https://merblog.example.com/rss,다른블로그|https://other.example.com/feed
#   - 제목을 생략하면 RSS 채널의 title(피드 제목)을 사용하고, 그것도 없으면 URL을 사용합니다.
BRIEF_BLOGS_RSS_URL=
# 블로그/뉴스: 일반 고정 링크 (제목|URL 형식, 쉼표로 여러 개)
# 예) BRIEF_BLOGS_EXTRA_LINKS=내블로그|https://blog.example.com,뉴스|https://news.example.com
BRIEF_BLOGS_EXTRA_LINKS=

# ---- 수동 보정 (데이터 소스 불명확 시) ----
# US 10Y 수동값 (FRED/Stooq 모두 실패 시)
US10Y_MANUAL=
