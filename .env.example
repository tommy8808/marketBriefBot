# ---- Telegram ----
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat ID to receive messages (number or @username)
TELEGRAM_CHAT_ID=your_chat_id_here

# ---- FRED (skip if key not set) ----
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- Brief items ----
# Commodities: Stooq symbols, comma-separated (e.g. CL.F, WTI.F, BZ.F)
BRIEF_COMMODITIES_SYMBOLS=CL.F,WTI.F,BZ.F

# Private company: manual value (N/A if empty)
BRIEF_PRIVATE_COMPANY=
# Optional link for above
BRIEF_PRIVATE_COMPANY_LINK=

# VIX: manual fallback when Stooq fails
VIX_MANUAL=

# ADR Index: manual value or Stooq symbol
BRIEF_ADR_INDEX=
BRIEF_ADR_INDEX_SYMBOL=^BKX

# FX: Stooq symbols, comma-separated (e.g. USDKRW=X, JPYKRW=X)
BRIEF_FX_PAIRS=USDKRW=X,JPYKRW=X

# BDI: manual fallback when Stooq fails
BDI_MANUAL=

# Blogs/RSS: comma-separated. Format "Title|RSS_URL" or URL only (uses feed title)
# Example: BlogA|https://blog.example.com/rss,https://other.com/feed
BRIEF_BLOGS_RSS_URL=
# Extra static links: "Title|URL,..."
# Example: My Blog|https://blog.example.com,News|https://news.example.com
BRIEF_BLOGS_EXTRA_LINKS=

# ---- Manual overrides ----
# US 10Y when FRED/Stooq both fail
US10Y_MANUAL=
